---

import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<section
				class="love-duration mb-7 rounded-xl border border-black/10 dark:border-white/15 bg-[var(--card-bg)]/70 px-5 py-4"
				aria-labelledby="love-duration-title"
			>
				<p id="love-duration-title" class="text-sm text-black/55 dark:text-white/55 mb-2">
					我们已经在一起
				</p>
				<div class="grid grid-cols-2 sm:grid-cols-4 gap-3" data-love-duration data-start-date="2024-09-28T00:00:00+08:00">
					<div class="duration-item">
						<strong data-duration-days>0</strong>
						<span>天</span>
					</div>
					<div class="duration-item">
						<strong data-duration-hours>0</strong>
						<span>小时</span>
					</div>
					<div class="duration-item">
						<strong data-duration-minutes>0</strong>
						<span>分钟</span>
					</div>
					<div class="duration-item">
						<strong data-duration-seconds>0</strong>
						<span>秒</span>
					</div>
				</div>
			</section>
			<Markdown class="mt-2">
				<Content />
			</Markdown>
		</div>
	</div>
</MainGridLayout>

<script>
	function updateLoveDuration() {
		const wrapper = document.querySelector("[data-love-duration]");
		if (!wrapper) return;

		const startDate = new Date(wrapper.getAttribute("data-start-date") || "");
		const diffMs = Date.now() - startDate.getTime();
		if (!Number.isFinite(diffMs) || diffMs < 0) return;

		const totalSeconds = Math.floor(diffMs / 1000);
		const days = Math.floor(totalSeconds / 86400);
		const hours = Math.floor((totalSeconds % 86400) / 3600);
		const minutes = Math.floor((totalSeconds % 3600) / 60);
		const seconds = totalSeconds % 60;

		wrapper.querySelector("[data-duration-days]")!.textContent = String(days);
		wrapper.querySelector("[data-duration-hours]")!.textContent = String(hours).padStart(2, "0");
		wrapper.querySelector("[data-duration-minutes]")!.textContent = String(minutes).padStart(2, "0");
		wrapper.querySelector("[data-duration-seconds]")!.textContent = String(seconds).padStart(2, "0");
	}

	updateLoveDuration();
	window.setInterval(updateLoveDuration, 1000);
</script>

<style>
	.duration-item {
		border-radius: 0.75rem;
		background: rgb(255 255 255 / 0.58);
		padding: 0.9rem 0.75rem;
		text-align: center;
	}

	:global(:root.dark) .duration-item {
		background: rgb(255 255 255 / 0.08);
	}

	.duration-item strong {
		display: block;
		font-size: clamp(1.55rem, 4vw, 2.35rem);
		line-height: 1;
		font-weight: 800;
		color: var(--primary);
		font-variant-numeric: tabular-nums;
	}

	.duration-item span {
		display: block;
		margin-top: 0.35rem;
		font-size: 0.85rem;
		color: rgb(0 0 0 / 0.58);
	}

	:global(:root.dark) .duration-item span {
		color: rgb(255 255 255 / 0.62);
	}
</style>
